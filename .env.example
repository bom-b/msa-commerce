# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT (256-bit 이상의 비밀키로 변경 필요)
JWT_SECRET=msa-commerce-jwt-secret-key-must-be-at-least-256-bits-long

# Kafka (docker-compose.yml 사용 시)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# 운영 배포 (docker-compose.yml)
# GHCR 이미지 경로: ghcr.io/<owner>/<repo>/<service>
GITHUB_REPOSITORY=owner/msa-commerce
IMAGE_TAG=latest

# Cloudflare Tunnel — 대시보드에서 발급한 터널 토큰
# 공개 hostname 라우팅(→ http://nginx:80)은 Cloudflare 대시보드에서 설정한다.
CLOUDFLARE_TUNNEL_TOKEN=
