root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,kt,kts,gradle}]
indent_size = 4
max_line_length = 150

[*.{yml,yaml}]
indent_size = 2

[*.{json,xml,html,css,scss,js,ts,tsx,jsx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
